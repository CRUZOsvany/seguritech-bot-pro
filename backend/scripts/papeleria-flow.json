      ]
    },
    {
      "id": "servicio_captura",
      "type": "wait_input",
      "content": {
        "prompt": "Perfecto, *{{servicio_seleccionado}}*. Dinos cuántas hojas/piezas necesitas (y si quieres, mándanos el archivo o dinos cómo nos lo haces llegar).",
        "save_to_context": "detalle_servicio"
      },
      "transitions": [
        { "condition": { "type": "default" }, "next_node_id": "servicio_escala" }
      ]
    },
    {
      "id": "servicio_escala",
      "type": "escape_to_human",
      "content": {
        "user_response": "🖨️ Listo, alguien de {{nombre_negocio}} te confirma el total y cuándo puedes pasar.",
        "owner_alert_template": "🖨️ SERVICIO: {{servicio_seleccionado}}\n📝 {{detalle_servicio}}\n📱 WhatsApp: {{phone}}"
      },
      "transitions": [
        { "condition": { "type": "default" }, "next_node_id": "fin" }
      ]
